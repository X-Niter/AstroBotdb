modules = ["nodejs-20", "postgresql-16"]
[nix]
channel = "stable-24_05"
packages = ["openssl", "postgresql", "unzip", "nodejs"]
[deployment]
deploymentTarget = "autoscale"
run = ["node", "index.js"]
[workflows]
runButton = "Project"
[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"
[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dashboard"
[[workflows.workflow]]
name = "Next.js Dashboard"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8000
externalPort = 8000
